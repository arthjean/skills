            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "input_shape",
                    "data_state",
                    "configuration",
                    "environment",
                    "platform",
                    "timing",
                    "concurrency",
                    "dependency_failure",
                    "load",
                    "user_interaction",
                    "third_party_behavior"
